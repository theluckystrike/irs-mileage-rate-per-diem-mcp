{
  "name": "irs-mileage-rate-per-diem-mcp",
  "version": "1.0.0",
  "description": "MCP server: IRS standard mileage rates 2011-2026 (76 cents from July 1, 2026), GSA per diem rates by ZIP for FY2026-FY2027, IRS high-low per diem.",
  "type": "module",
  "bin": {
    "irs-mileage-rate-per-diem-mcp": "dist/stdio.js"
  },
  "main": "dist/stdio.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "DATA_SOURCES.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "deploy": "wrangler deploy"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "irs",
    "mileage-rate",
    "standard-mileage-rate",
    "mileage-reimbursement",
    "per-diem",
    "gsa-per-diem",
    "per-diem-rates",
    "high-low-method",
    "travel-expenses",
    "business-travel",
    "tax-deductions"
  ],
  "author": "theluckystrike",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/theluckystrike/irs-mileage-rate-per-diem-mcp.git"
  },
  "homepage": "https://taxbreakcalc.com/self-employed-set-aside-calculator/",
  "mcpName": "io.github.theluckystrike/irs-mileage-rate-per-diem-mcp",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3",
    "wrangler": "^4.40.0"
  }
}
